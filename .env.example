# Copy to .env (git-ignored). Values below are for the local Docker PostgreSQL
# (127.0.0.1 only, no password). Never put real credentials in this file.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/g_scores
# Disposable database used only by tests; its name must end with _test.
DATABASE_URL_TEST=postgresql://postgres@127.0.0.1:5433/g_scores_test
# Port the API listens on (1-65535).
PORT=4000
