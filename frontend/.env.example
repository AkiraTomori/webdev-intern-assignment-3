# Copy to frontend/.env.local only if the backend is not at the default address below.
# Next.js reads .env files from this folder (frontend/), not from the repo root.
# Address of the backend API that /api/* is forwarded to. Read once, in next.config.ts.
# It is baked into the build: change it, then rebuild (next build). No secrets here.
BACKEND_URL=http://127.0.0.1:4000
